<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WebProjectDir>$(MSBuildProjectDirectory)\..\web</WebProjectDir>
    <!-- UseStaticFiles reads wwwroot directly. The SDK pipeline would snapshot the generated files during
         the build and break when Vite replaces them, and its dev manifest makes the host throw at startup
         if wwwroot is deleted after a build. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <!-- wwwroot is generated by "pnpm build". IncludeFrontendInPublish is its only route into the publish output. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <!-- Runs only when publishing, so dotnet build and dotnet test need neither Node nor a built frontend.
       Pass -p:SkipFrontendBuild=true to publish the existing wwwroot as it is. -->
  <Target Name="IncludeFrontendInPublish" AfterTargets="ComputeFilesToPublish">
    <Exec Condition="'$(SkipFrontendBuild)' != 'true'" Command="pnpm install --frozen-lockfile" WorkingDirectory="$(WebProjectDir)" />
    <Exec Condition="'$(SkipFrontendBuild)' != 'true'" Command="pnpm build" WorkingDirectory="$(WebProjectDir)" />

    <ItemGroup>
      <_WebRootFile Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(_WebRootFile->'%(FullPath)')">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
