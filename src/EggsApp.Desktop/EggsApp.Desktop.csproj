<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The API is an executable on its own, but here it only runs in-process, as a library. Without this, a
         self-contained publish fails with NETSDK1150. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggsApp.Api\EggsApp.Api.csproj" />
  </ItemGroup>

  <!-- Debug runs from bin, which has no wwwroot: use the output of "pnpm build" directly. See AppPaths. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="DevWebRoot" Value="$(MSBuildThisFileDirectory)..\EggsApp.Api\wwwroot" />
  </ItemGroup>

  <Import Project="..\Frontend.targets" />

  <!-- Files the referenced API project brings that the shipped app never uses: the API's own launcher (it only runs
       in-process here) and its Development settings (the embedded host is always Production). The .pdb files stay,
       so logged stack traces have line numbers. installer\build.ps1 checks that none of these are published. -->
  <Target Name="RemoveUnusedPublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(RelativePath)' == 'EggsApp.Api.exe'
                                        Or '%(RelativePath)' == 'EggsApp.Api.runtimeconfig.json'
                                        Or '%(RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>

</Project>
